{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skiu Vibrance",
  "version": "1.1.0",
  "identifier": "fr.ceasolutions.skiuvibrance",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Skiu Vibrance",
        "width": 1120,
        "height": 740,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CeA Solutions",
    "shortDescription": "Vibrance NVIDIA automatique par jeu",
    "longDescription": "Bascule automatiquement la vibrance numerique NVIDIA selon le jeu au premier plan.",
    "category": "Utility",
    "copyright": "CeA Solutions",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
